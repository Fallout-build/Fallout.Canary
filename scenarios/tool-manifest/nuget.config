<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Deliberately nuget.org only, unlike the repo-root nuget.config. This scenario checks the
       install path a public consumer actually uses: `dotnet tool install` / `dotnet tool restore`
       against nuget.org. Routing the tool to the GitHub Packages -preview feed would test a feed
       most consumers never configure, and would not have caught Fallout-build/Fallout#575. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- The root config maps Fallout.* to the GitHub Packages feed. Without clearing that here, the
       inherited mapping still points at a source this file has removed, and the restore fails with
       "no source mapped under the specified package ID". -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
