<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <!-- Scenario root = scenarios/upgrade (one up from build/). -->
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The upgrade hop under test. Unlike the other scenarios this one does NOT float: the
         whole point is to move a consumer from one specific version to another and see whether
         they survive it.

         Baseline = the last GA of the previous production line. Pinned exactly, because it is
         history: it is what a real consumer is sitting on today.

         Target = the newest thing on nuget.org, floated. nuget.org only ever carries the
         production line (main's -preview builds go to GitHub Packages and never here), so
         `*-*` resolves to the current line's newest release candidate or GA without needing
         an edit every time a version ships.

         Both are overridable. Override them through the ENVIRONMENT, not `-p:` — MSBuild reads
         environment variables as global properties, and `dotnet run` forwards anything it does
         not recognise to the built app, where Fallout parses it as a target name. So prefix the
         command with `CanaryFalloutVersion=10.4.0-rc.5` rather than passing a property flag; see
         this scenario's README for the failure that shape produces.

         The `Canary` prefix keeps these clear of the `Fallout*` MSBuild properties that
         `fallout-migrate` rewrites, since this scenario deliberately runs the migrator. -->
    <CanaryBaselineVersion Condition="'$(CanaryBaselineVersion)' == ''">10.3.49</CanaryBaselineVersion>
    <CanaryTargetVersion Condition="'$(CanaryTargetVersion)' == ''">*-*</CanaryTargetVersion>
    <!-- Defaults to the baseline so the scenario opens in its "before the upgrade" state. -->
    <CanaryFalloutVersion Condition="'$(CanaryFalloutVersion)' == ''">$(CanaryBaselineVersion)</CanaryFalloutVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="$(CanaryFalloutVersion)" />
  </ItemGroup>

</Project>
