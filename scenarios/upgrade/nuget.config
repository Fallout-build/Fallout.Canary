<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Deliberately nuget.org only, like scenarios/tool-manifest and unlike the repo root. A
       consumer upgrading from one released line to the next restores from nuget.org; the
       GitHub Packages -preview feed is one most of them never configure, and routing this
       scenario there would test a hop no consumer actually makes. It also means this
       scenario needs no FALLOUT_PACKAGES_TOKEN. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- The root config maps Fallout.* to the GitHub Packages feed. Without clearing that here,
       the inherited mapping still points at a source this file has removed, and the restore
       fails with "no source mapped under the specified package ID". -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
